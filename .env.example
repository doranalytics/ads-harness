# Copy to .env.local for local dev; set the same names in Vercel →
# Project → Settings → Environment Variables for production.

# --- required ---------------------------------------------------------------
# The password at the door of the app.
APP_PASSWORD=
# A long random string the app hands to a signed-in browser. Generate one:
#   openssl rand -hex 32
SESSION_TOKEN=
# Supabase → Settings → API Keys: a new sb_secret_ key or legacy service_role
# JWT, plus the project URL. The secret key stays server-side; never put it in a
# NEXT_PUBLIC_ variable.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Lets Vercel Cron call the daily syncs. Any long random string; Vercel
# sends it automatically once it's set in the project.
CRON_SECRET=

# --- demo ---------------------------------------------------------------------
# NEXT_PUBLIC_DEMO=1 turns the whole app into a walk-through with invented
# sample data and NO password. Only for showing the UI — leave it unset on
# a real deployment. Switching it requires a rebuild/redeploy.
NEXT_PUBLIC_DEMO=1

# --- optional ---------------------------------------------------------------
# Your business name in the header, tab title and sign-in screen.
NEXT_PUBLIC_BRAND_NAME=
# Live ad creation/control AND automation require this explicit opt-in.
# Keep 0 for reporting. Auto-off also needs its separate saved-rule toggle.
META_WRITES_ENABLED=0
# Server-only Marketing API version. Default v26.0; verify against Meta docs.
META_GRAPH_VERSION=v26.0
# Optional read-only MCP credential. Create/store only after your explicit consent.
# Accepted only by GET /api/data, never by mutation/sync routes.
MCP_READ_TOKEN=

# Everything below can instead be saved from the app (Settings → Connector
# keys), which is the easier route. The env vars are only fallbacks.
APIFY_TOKEN=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_ADSET_ID=
META_PAGE_ID=
META_AD_LINK=
META_AD_CTA=
# Only if you promote a mobile app and use AppStack:
APPSTACK_APP_ID=
APPSTACK_MCP_KEY=
