# Copy to .env.local for local dev; set the same names in Vercel →
# Project → Settings → Environment Variables for production.

# --- required ---------------------------------------------------------------
# The password at the door of the app.
APP_PASSWORD=
# A long random string the app hands to a signed-in browser. Generate one:
#   openssl rand -hex 32
SESSION_TOKEN=
# Supabase → Project Settings → API: the project URL and the service_role
# (secret) key. The secret key stays server-side; never put it in a
# NEXT_PUBLIC_ variable.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Lets Vercel Cron call the daily syncs. Any long random string; Vercel
# sends it automatically once it's set in the project.
CRON_SECRET=

# --- optional ---------------------------------------------------------------
# Your business name in the header, tab title and sign-in screen.
NEXT_PUBLIC_BRAND_NAME=

# Everything below can instead be saved from the app (Settings → Connector
# keys), which is the easier route. The env vars are only fallbacks.
APIFY_TOKEN=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_ADSET_ID=
META_PAGE_ID=
META_AD_LINK=
META_AD_CTA=
# Only if you promote a mobile app and use AppStack:
APPSTACK_APP_ID=
